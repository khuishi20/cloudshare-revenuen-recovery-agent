# Copy this to a .env file or export these as real environment variables
# before running the app. Never commit real values.

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# optional - defaults to http://127.0.0.1:8123 if not set
AGENT_SERVICE_URL=http://127.0.0.1:8123
